---
import DefaultSidebar
  from '@astrojs/starlight/components/Sidebar.astro';

const pathname = Astro.url.pathname;

const route = Astro.locals.starlightRoute;
const sidebar = route.sidebar;

const isHomeOrAbout = (entry: any) =>
  entry.type === 'link' &&
  (
    entry.href === '/' ||
    entry.href === '/sobre/' ||
    entry.href === '/sobre'
  );

let filteredSidebar = sidebar;

if (pathname.startsWith('/torah/')) {
  filteredSidebar = sidebar.filter(
    (entry: any) =>
      isHomeOrAbout(entry) ||
      (
        entry.type === 'group' &&
        entry.label === 'Torah'
      )
  );
}
else if (pathname.startsWith('/parashot/')) {
  filteredSidebar = sidebar.filter(
    (entry: any) =>
      isHomeOrAbout(entry) ||
      (
        entry.type === 'group' &&
        entry.label === 'Parashot'
      )
  );
}
else {
  filteredSidebar = sidebar.filter(
    (entry: any) =>
      isHomeOrAbout(entry)
  );
}

/*
 * O Sidebar padrão do Starlight lê diretamente
 * Astro.locals.starlightRoute.sidebar.
 *
 * Portanto alteramos o array original antes
 * de renderizar o componente padrão.
 */
sidebar.splice(
  0,
  sidebar.length,
  ...filteredSidebar
);
---

<DefaultSidebar />