---
type ExtraData = {
  category?: 'torah' | 'parashat' | 'institucional';
};

const data =
  Astro.locals.starlightRoute.entry.data as
    typeof Astro.locals.starlightRoute.entry.data &
    ExtraData;

const categoryLabels = {
  torah: 'Torah',
  parashat: 'Parashat',
  institucional: 'Institucional',
};

const category =
  data.category
    ? categoryLabels[data.category]
    : undefined;
---

<h1 id="_top">{data.title}</h1>

{category && (
  <div
    class="article-meta"
    aria-label="Categoria da publicação"
  >
    <span class="article-meta__category">
      {category}
    </span>
  </div>
)}